{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent review result v1",
  "type": "object",
  "required": [
    "result", "reviewer_id", "checked_criteria", "evidence", "reason",
    "faulty_node", "recommendation", "failed_criteria",
    "affected_downstream_nodes", "reviewed_at"
  ],
  "properties": {
    "result": {"enum": ["pass", "fail", "uncertain"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "checked_criteria": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 32768}},
    "evidence": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/evidence"}},
    "reason": {"type": ["string", "null"]},
    "faulty_node": {"type": ["string", "null"]},
    "recommendation": {"type": ["string", "null"]},
    "failed_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "faulty_node_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "affected_downstream_nodes": {"type": "array", "items": {"type": "string"}},
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "pass"}}},
      "then": {
        "properties": {
          "checked_criteria": {"minItems": 1},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "fail"}}},
      "then": {
        "required": [
          "reason", "faulty_node", "recommendation", "failed_criteria",
          "faulty_node_criteria",
          "affected_downstream_nodes"
        ],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "faulty_node": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "failed_criteria": {"type": "array", "minItems": 1},
          "faulty_node_criteria": {"type": "array", "minItems": 1},
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "uncertain"}}},
      "then": {
        "properties": {
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["criterion", "kind", "summary"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1, "maxLength": 32768},
        "kind": {"type": "string", "minLength": 1, "maxLength": 32768},
        "summary": {"type": "string", "minLength": 1, "maxLength": 32768}
      },
      "additionalProperties": true
    }
  }
}
