{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent review result v1",
  "type": "object",
  "required": ["result", "reviewer_id", "checked_criteria", "evidence"],
  "properties": {
    "result": {"enum": ["pass", "fail", "uncertain"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "checked_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "reason": {"type": ["string", "null"]},
    "faulty_node": {"type": ["string", "null"]},
    "recommendation": {"type": ["string", "null"]},
    "failed_criteria": {"type": "array", "items": {"type": "string"}},
    "faulty_node_criteria": {"type": "array", "items": {"type": "string"}},
    "affected_downstream_nodes": {"type": "array", "items": {"type": "string"}},
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "fail"}}},
      "then": {
        "required": [
          "reason", "faulty_node", "recommendation", "failed_criteria",
          "faulty_node_criteria",
          "affected_downstream_nodes"
        ],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "faulty_node": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "failed_criteria": {"type": "array", "minItems": 1},
          "faulty_node_criteria": {"type": "array", "minItems": 1},
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
